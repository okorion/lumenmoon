# 반드시 local 또는 online 중 하나를 명시합니다.
VITE_REPOSITORY_MODE=local

# online 모드에서만 아래 세 값을 채웁니다.
# VITE_REPOSITORY_MODE=online
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=Supabase status에 표시되는 로컬 anon/publishable 키
# VITE_SUPABASE_WORLD_ID=00000000-0000-4000-8000-000000000001

# service-role 키는 VITE_ 환경 변수나 브라우저 코드에 넣지 않습니다.

# 익명 제품 분석은 기본 비활성입니다. 사용자가 동의한 뒤에만 SDK를 불러옵니다.
VITE_ANALYTICS_ENABLED=false
# 브라우저 공개 project token만 사용합니다. 개인 API 키는 넣지 않습니다.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
# production | staging | development | test (생략하면 Vite MODE 사용)
VITE_ANALYTICS_ENV=development

# 개발 중에만 FPS/draw call/표시 블록/활성 청크 HUD를 표시합니다.
VITE_PERF_HUD=false
