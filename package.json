{
  "name": "lumenmoon",
  "description": "자유롭게 내 블록을 남기거나 다른 사람과 별빛 관문을 완성하는 1인칭 복셀 건축 게임",
  "keywords": [
    "voxel",
    "web",
    "game",
    "three.js",
    "supabase",
    "multiplayer",
    "collaborative-building",
    "webgl",
    "korean"
  ],
  "author": "okorion",
  "homepage": "https://lumenmoon.vercel.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/okorion/lumenmoon.git"
  },
  "private": true,
  "version": "0.2.0",
  "engines": {
    "node": ">=22 <26"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/check-build-budget.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:online": "playwright test e2e/online-shared-world.spec.ts e2e/renderer-memory.spec.ts e2e/lumenmoon-world-visual.spec.ts",
    "icons:build": "node scripts/render-icons.mjs",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "test:db": "supabase test db",
    "test:db:client": "vitest run tests/supabase.integration.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "posthog-js": "^1.415.2",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "26.2.0",
    "@types/three": "0.185.4",
    "eslint": "10.8.1",
    "fake-indexeddb": "6.2.4",
    "globals": "17.9.0",
    "supabase": "^2.113.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
