{
  "name": "one-more-block",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:online": "playwright test e2e/online-shared-world.spec.ts e2e/renderer-memory.spec.ts",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "test:db": "supabase test db",
    "test:db:client": "vitest run tests/supabase.integration.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "posthog-js": "^1.415.2",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "26.2.0",
    "@types/three": "0.185.4",
    "eslint": "10.8.1",
    "fake-indexeddb": "6.2.4",
    "globals": "17.9.0",
    "supabase": "^2.113.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
